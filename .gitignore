# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# PyTorch checkpoints and heavy arrays
checkpoints/
*.pt
*.pth
*.npy
*.npz

# Data directories (raw frames & videos)
data/*/vid_*
data/real_*
data/.temp*
data/raw_*
data/tier2_real/
videos/
results/.temp*

# Keep metadata manifests tracked
!data/metadata/
!data/metadata/*.json
!data/metadata/*.csv
!data/metadata_real/
!data/metadata_real/*.json
!data/metadata_real/*.csv

# OS and IDE files
.DS_Store
.vscode/
.idea/

# Testing and environments
.pytest_cache/
.coverage
htmlcov/
env/
venv/
.env

# Antigravity agents
.agents/
